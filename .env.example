# Copy to .env.local for local development, and set the same names in
# Vercel > Project > Settings > Environment Variables for production.
# Variables WITHOUT the VITE_ prefix stay on the server and never reach the browser.

# --- Required in production -------------------------------------------------
# fal.ai key (https://fal.ai/dashboard/keys). Leave empty locally to use mock images.
FAL_KEY=
# Long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared data store (accounts, credits, leaderboards, galleries, rate limits).
# Add "Upstash for Redis" from the Vercel Marketplace and these are set for you.
# Locally, leave them empty to use an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional ----------------------------------------------------------------
# FAL_MOCK=1                     # force fake images and judge, even with a key
# FREE_DAILY_CREDITS=5           # free credits per player per day
# DAILY_GENERATION_CAP=3000      # max AI calls per day for the whole site
# RATE_LIMIT_PER_MINUTE=200      # max AI calls per minute per IP (venues share one IP)
# GUEST_CREDITS_PER_IP=150       # max guest games per IP per day (logged-in players are not capped)
# REDEEM_CODES=LAUNCH50:50,FRIENDS10:10   # code:credits pairs, one use per account
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_EDIT_MODEL=fal-ai/flux-pro/kontext
# FAL_SKETCH_MODEL=fal-ai/lcm-sd15-i2i
# FAL_REALTIME_MODEL=fal-ai/lcm-sd15-i2i
# FAL_JUDGE_ENDPOINT=openrouter/router/vision
# FAL_JUDGE_MODEL=google/gemini-2.5-flash

# --- Browser (VITE_ prefix: these are public) -------------------------------
# Self-hosted PeerJS server for party modes (default: the free PeerJS cloud)
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# Stripe Payment Links. Buttons show "Coming soon" when empty.
# VITE_STRIPE_PRO_LINK=
# VITE_STRIPE_TEAM_LINK=
# VITE_STRIPE_PACK_STARTER_LINK=
# VITE_STRIPE_PACK_POPULAR_LINK=
# VITE_STRIPE_PACK_MEGA_LINK=
